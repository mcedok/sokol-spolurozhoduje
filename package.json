{
  "name": "sokol-spolurozhoduje",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build && node scripts/prepare-sites.mjs",
    "start": "vinext start",
    "smoke:access": "node scripts/smoke-access.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "test:server": "vitest run test/server",
    "test:server:db": "vitest run test/server/database-foundation.test.ts",
    "db:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/local/compose.yaml down",
    "db:migrate": "tsx server/db/migrate.ts",
    "bootstrap:superadmin": "tsx server/db/bootstrap-superadmin.ts",
    "pilot:init": "node scripts/local-pilot.mjs init",
    "pilot:start": "node scripts/local-pilot.mjs start",
    "pilot:status": "node scripts/local-pilot.mjs status",
    "pilot:stop": "node scripts/local-pilot.mjs stop",
    "pilot:mailbox": "node scripts/local-pilot.mjs mailbox",
    "pilot:smoke-ui": "node scripts/smoke-local-pilot-ui.mjs",
    "pilot:ensure-admin": "tsx server/db/bootstrap-superadmin.ts",
    "pilot:ensure-storage": "tsx scripts/ensure-storage.ts",
    "dev:server": "next dev",
    "build:server": "next build",
    "start:server": "next start"
  },
  "dependencies": {
    "@azure/storage-blob": "12.33.0",
    "@fastify/busboy": "3.2.0",
    "@node-rs/argon2": "^2.1.0",
    "@tanstack/react-virtual": "3.14.9",
    "fflate": "0.8.2",
    "next": "16.2.11",
    "otplib": "^13.4.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.22.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "0.5.27",
    "jsdom": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.62.0"
  }
}
