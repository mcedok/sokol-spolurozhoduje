{
  "name": "sokol-spolurozhoduje",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build && node scripts/prepare-sites.mjs",
    "start": "vinext start",
    "smoke:access": "node scripts/smoke-access.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:server": "vitest run test/server",
    "test:server:db": "vitest run test/server/database-foundation.test.ts",
    "db:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/local/compose.yaml down",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev:server": "next dev",
    "build:server": "next build",
    "start:server": "next start"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "next": "16.2.11",
    "otplib": "^13.4.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.22.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "0.5.27",
    "jsdom": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.62.0"
  }
}
